# Public URL used by install commands and generated links.
NODEHUB_PUBLIC_URL=http://localhost:8080

# Shared bootstrap token for agents. Change this.
AGENT_TOKEN=change-me-agent-token

# First-run admin account. Change this before exposing the panel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# At least 32 random characters. Do not change after storing secrets.
JWT_SECRET=change-me-32-byte-random-secret-000000
